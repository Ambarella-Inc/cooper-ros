<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cooper_ros_yolox</name>
  <version>0.0.1</version>
  <description>Cooper ROS YOLOX</description>
  <maintainer email="cooper_robot@ambarella.com">Cooper ROS Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>

  <depend>nlohmann_json</depend>
  <depend>opencv2</depend>

  <exec_depend>cooper_ros_iav_osd</exec_depend>
  <exec_depend>cooper_ros_iav_canvas</exec_depend>
  <exec_depend>cooper_ros_cv_file</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
